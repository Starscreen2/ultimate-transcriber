<Page
    x:Class="TranscribeToText.Windows.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:TranscribeToText.Windows.Pages">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="22">
            <StackPanel Spacing="6">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Local models and hardware choices are saved on this PC." Opacity="0.72" />
            </StackPanel>

            <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Transcription" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Preferred Whisper model" />
                    <ComboBox x:Name="DefaultModelPicker" DisplayMemberPath="Name" />
                    <TextBlock Text="Preferred language" />
                    <ComboBox x:Name="DefaultLanguagePicker" SelectedIndex="0">
                        <ComboBoxItem Content="Auto detect" Tag="auto" />
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="Spanish" Tag="es" />
                        <ComboBoxItem Content="French" Tag="fr" />
                        <ComboBoxItem Content="German" Tag="de" />
                        <ComboBoxItem Content="Chinese" Tag="zh" />
                        <ComboBoxItem Content="Japanese" Tag="ja" />
                        <ComboBoxItem Content="Korean" Tag="ko" />
                    </ComboBox>
                    <TextBox x:Name="DefaultLanguageCodeBox" PlaceholderText="Other language code (e.g. it)" />
                    <TextBlock x:Name="DefaultLanguageModeHint" TextWrapping="Wrap" Opacity="0.7" />
                    <CheckBox x:Name="DefaultSpeakerCheckBox" Content="Detect speakers by default" />
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Hardware" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="CPU is always available when built. CUDA uses an NVIDIA GPU. Vulkan is the AMD path and may also work on NVIDIA hardware." TextWrapping="Wrap" Opacity="0.78" />
                    <ComboBox x:Name="BackendPicker" SelectedIndex="0">
                        <ComboBoxItem Content="CPU (recommended baseline)" Tag="cpu" />
                        <ComboBoxItem Content="Auto (CUDA, Vulkan, then CPU)" Tag="auto" />
                        <ComboBoxItem Content="NVIDIA CUDA" Tag="cuda" />
                        <ComboBoxItem Content="Vulkan" Tag="vulkan" />
                    </ComboBox>
                    <TextBlock x:Name="BackendStatus" TextWrapping="Wrap" Opacity="0.72" />
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Meeting detection" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox x:Name="MeetingDetectionCheckBox" Content="Show a reminder when a supported meeting window is detected" />
                    <TextBlock Text="Detection only watches for visible Zoom, Teams, or Google Meet windows. It never starts recording automatically; you choose when to start." TextWrapping="Wrap" Opacity="0.72" />
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Local models" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Models download to %LOCALAPPDATA%\TranscribeToText. The twelve Whisper models match the Mac choices." TextWrapping="Wrap" Opacity="0.72" />
                    <ListView x:Name="ModelsList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ModelRow">
                                <Grid Padding="8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Opacity="0.68" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Status}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Download" Tag="{x:Bind Id}"
                                            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" Click="DownloadModel_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="ModelStatus" TextWrapping="Wrap" />
                    <ProgressBar x:Name="ModelProgress" Minimum="0" Maximum="100" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Button Content="Save settings" HorizontalAlignment="Left" Click="SaveSettings_Click" />
        </StackPanel>
    </ScrollViewer>
</Page>
