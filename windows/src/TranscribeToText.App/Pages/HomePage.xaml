<Page
    x:Class="TranscribeToText.Windows.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock Text="Transcribe to Text" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Transcribe audio and video locally on this PC." Opacity="0.72" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ChooseFileButton" Content="Choose media…" Click="ChooseFile_Click" />
            <TextBlock x:Name="SelectedFileText" Grid.Column="1" VerticalAlignment="Center"
                       Text="No file selected" TextTrimming="CharacterEllipsis" />
            <Button x:Name="ImportArchiveButton" Grid.Column="2" Content="Import .whisper…" Click="ImportArchive_Click" />
            <Button x:Name="ExportArchiveButton" Grid.Column="3" Content="Export .whisper…" Click="ExportArchive_Click" IsEnabled="False" />
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="Whisper model" />
                <ComboBox x:Name="ModelPicker" DisplayMemberPath="Name" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="Language" />
                <ComboBox x:Name="LanguagePicker" SelectedIndex="0">
                    <ComboBoxItem Content="Auto detect" Tag="auto" />
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="Spanish" Tag="es" />
                    <ComboBoxItem Content="French" Tag="fr" />
                    <ComboBoxItem Content="German" Tag="de" />
                    <ComboBoxItem Content="Chinese" Tag="zh" />
                    <ComboBoxItem Content="Japanese" Tag="ja" />
                    <ComboBoxItem Content="Korean" Tag="ko" />
                </ComboBox>
                <TextBox x:Name="LanguageCodeBox" PlaceholderText="Other language code (e.g. it)" />
                <TextBlock x:Name="LanguageModeHint" TextWrapping="Wrap" Opacity="0.7" />
            </StackPanel>
            <CheckBox x:Name="DetectSpeakersCheckBox" Grid.Column="2" Content="Detect speakers" VerticalAlignment="Bottom" />
            <Button x:Name="TranscribeButton" Grid.Column="3" Content="Transcribe" VerticalAlignment="Bottom"
                    Click="Transcribe_Click" />
        </Grid>
        <Grid Grid.Row="3" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing x:Name="BusyIndicator" Width="18" Height="18" IsActive="False" />
                <TextBlock x:Name="StatusText" Text="Choose an audio or video file to get started."
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button x:Name="CopyButton" Content="Copy transcript" Click="CopyTranscript_Click" IsEnabled="False" />
                <Button x:Name="OpenOutputButton" Content="Open output folder" Click="OpenOutput_Click" IsEnabled="False" />
            </StackPanel>
            <TextBox x:Name="TranscriptBox" Grid.Row="1" AcceptsReturn="True" IsReadOnly="True"
                     TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     PlaceholderText="Transcript text will appear here." />
        </Grid>
    </Grid>
</Page>
