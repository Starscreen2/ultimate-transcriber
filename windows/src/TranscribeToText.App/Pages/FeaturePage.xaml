<Page
    x:Class="TranscribeToText.Windows.Pages.FeaturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Text="Workspace" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock x:Name="Description" Grid.Row="1" TextWrapping="Wrap" Opacity="0.78" />
    </Grid>
</Page>
