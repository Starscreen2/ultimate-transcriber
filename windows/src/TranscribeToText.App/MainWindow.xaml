<Window
    x:Class="TranscribeToText.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="Transcribe to Text">
    <Grid>
        <muxc:NavigationView
            x:Name="RootNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavigationChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Home" Tag="home" Icon="Home" />
                <muxc:NavigationViewItem Content="Queue" Tag="queue" Icon="List" />
                <muxc:NavigationViewItem Content="Transcriptions" Tag="transcriptions" Icon="Document" />
                <muxc:NavigationViewItem Content="Meetings" Tag="meetings" Icon="People" />
                <muxc:NavigationViewItem Content="Recently Deleted" Tag="deleted" Icon="Delete" />
            </muxc:NavigationView.MenuItems>
            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" />
            </muxc:NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>
    </Grid>
</Window>
